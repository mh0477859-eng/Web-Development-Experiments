<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muhammad Hasan | Web Developer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #333;
            scroll-behavior: smooth;
        }

        .container {
            width: 90%;
            max-width: 1000px;
            margin: auto;
            padding: 20px 0;
        }

        header {
            background: #2e7d32;
            color: #fff;
            padding: 100px 0;
            text-align: center;
        }

        header h1 span {
            color: #FFD700;
        }

        header p {
            margin: 10px 0 20px;
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .btn {
            display: inline-block;
            background: #FFD700;
            color: #333;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #e6c200;
            transform: translateY(-2px);
        }

        section {
            padding: 80px 0;
            text-align: center;
        }

        h2 {
            margin-bottom: 30px;
            font-size: 2rem;
            position: relative;
        }

        .skills-list {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .skill {
            background: #f4f4f4;
            padding: 12px 25px;
            border-radius: 50px;
            border: 1px solid #ddd;
            font-weight: 500;
        }

        form {
            max-width: 500px;
            margin: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
            text-align: left;
        }

        input, textarea {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 100%;
            font-size: 1rem;
        }

        textarea {
            resize: vertical;
            min-height: 120px;
        }

        button {
            padding: 12px;
            background: #2e7d32;
            color: #fff;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-size: 1rem;
            transition: 0.3s;
        }

        button:hover {
            background: #1b5e20;
        }

        footer {
            background: #222;
            color: #fff;
            padding: 30px 0;
            text-align: center;
        }

        #msg {
            margin-top: 15px;
            color: #2e7d32;
            font-weight: bold;
            min-height: 24px;
        }

        @media (max-width: 600px) {
            header { padding: 60px 0; }
            h2 { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

    <header>
        <div class="container">
            <h1>Hello, I am <span>Muhammad Hasan</span></h1>
            <p>Front-End Web Developer | HTML, CSS & JavaScript</p>
            <a href="#contact" class="btn">Contact Me</a>
        </div>
    </header>

    <section id="about">
        <div class="container">
            <h2>About Me</h2>
            <p>
                I am a passionate front-end web developer skilled in HTML, CSS, and JavaScript. 
                I create responsive, user-friendly websites with clean and efficient code. 
            </p>
        </div>
    </section>

    <section id="skills" style="background: #fafafa;">
        <div class="container">
            <h2>Skills</h2>
            <div class="skills-list">
                <div class="skill">HTML5</div>
                <div class="skill">CSS3</div>
                <div class="skill">JavaScript</div>
                <div class="skill">Responsive Design</div>
            </div>
        </div>
    </section>

    <section id="contact">
        <div class="container">
            <h2>Contact Me</h2>
            <form id="contactForm">
                <input type="text" id="name" placeholder="Your Name" required>
                <input type="email" id="email" placeholder="Your Email" required>
                <textarea id="message" placeholder="Your Message" required></textarea>
                <button type="submit">Send Message</button>
            </form>
            <p id="msg"></p>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Muhammad Hasan | Built with Love</p>
    </footer>

    <script>
        const form = document.getElementById('contactForm');
        const msg = document.getElementById('msg');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            msg.textContent = '✅ Thank you! I will get back to you soon.';
            form.reset();
            
            // Message auto-hide after 5 seconds
            setTimeout(() => { msg.textContent = ''; }, 5000);
        });
    </script>
</body>
</html>
